{
    "name": "nfse-nacional/nfse-php",
    "description": "This is my package nfse",
    "keywords": [
        "Nfse",
        "nfse"
    ],
    "homepage": "https://github.com/nfse-nacional/nfse-php",
    "license": "MIT",
    "authors": [
        {
            "name": "a21ns1g4ts",
            "email": "a21ns1g4ts@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^7.3 || ^8.0",
        "guzzlehttp/guzzle": "7.5.0",
        "guzzlehttp/promises": "1.5.2",
        "guzzlehttp/psr7": "2.4.3",
        "psr/http-client": "1.0.1",
        "psr/http-factory": "1.0.1",
        "psr/http-message": "1.0.1",
        "spatie/data-transfer-object": "dev-illi",
        "symfony/polyfill-php80": "^1.28",
        "symfony/polyfill-php81": "^1.28"
    },
    "require-dev": {
        "pestphp/pest": "^1.23",
        "phpunit/phpunit": "^9.6"
    },
    "suggest": {
        "spatie/typescript-transformer": "Opcional (PHP >=8.2) para regenerar o arquivo types/generated.d.ts.",
        "nfse-nacional/danfse-php": "Gera o PDF do DANFSe localmente a partir do NfseData (PHP >= 8.3)."
    },
    "autoload": {
        "psr-4": {
            "Nfse\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nfse\\Tests\\": "tests"
        }
    },
    "repositories": {
        "illimitar-data-transfer-object": {
            "type": "vcs",
            "url": "https://github.com/illimitar/data-transfer-object",
            "no-api": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "audit": {
            "ignore": {
                "PKSA-z3gr-8qht-p93v": "*"
            }
        },
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "archive": {
        "exclude": [
            "/docs",
            "/references",
            "/tests",
            "/examples",
            "/.github",
            "/.phpunit.cache",
            "*.xml",
            "*.yml",
            "*.neon",
            "*.json",
            "*.lock",
            "!composer.json",
            "*.pdf",
            "*.xlsx",
            "*.jpg",
            "*.png",
            "*.ico",
            "*.pfx",
            "*.zip",
            "*.tar",
            "*.gz",
            "*.rar",
            ".DS_Store"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
